<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
    <div class="flex items-center gap-5">
      <.link navigate={~p"/"}>
        <span class="font-bold text-xl">Vik</span>
      </.link>
      <div class="flex items-center gap-2 lowercase">
        <p class="bg-purple-600/5 text-purple-600 rounded-full px-2 font-medium leading-6">
          <span class="hidden sm:inline">Elixir</span> v{System.version()}
        </p>
        <p class="bg-brand/5 text-brand rounded-full px-2 font-medium leading-6">
          <span class="hidden sm:inline">Phoenix</span> v{Application.spec(:phoenix, :vsn)}
        </p>
      </div>
    </div>
    <div class="flex items-center gap-4 font-semibold leading-6 text-zinc-900">
      <.link
        navigate={~p"/new"}
        class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80 flex items-center gap-1"
      >
        <.icon name="hero-plus size-3" /> New
      </.link>
    </div>
  </div>
</header>
<main class="p-3 md:px-6">
  <.flash_group flash={@flash} />
  {@inner_content}
</main>
