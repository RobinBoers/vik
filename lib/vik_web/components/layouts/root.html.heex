<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <!-- Google, please don't mess with my lovingly handcrafted HTML -->
    <meta name="googlebot" content="notranslate" />
    <meta name="generator" content={"Phoenix #{Application.spec(:phoenix, :vsn)}"} />

    <.live_title default="Vik">
      {assigns[:page_title]}
    </.live_title>

    <link rel="canonical" href="https://vik.dupunkto.org" />

    <%= if assigns[:authenticated?] do %>
      <link rel="stylesheet" href="https://cdn.geheimesite.nl/tools.css" />
      <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <% else %>
      <link rel="stylesheet" href="https://cdn.geheimesite.nl/landing.css" />
    <% end %>

    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
